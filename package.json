{
  "name": "petz24-7",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:release:clean": "cd android && ./gradlew clean assembleRelease",
    "android:bundle:clean": "cd android && ./gradlew clean bundleRelease",
    "android:adb:devices": "adb devices",
    "android:adb:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:adb:start": "adb shell am start -n com.petz247/.MainActivity",
    "android:adb:stop": "adb shell am force-stop com.petz247",
    "android:adb:uninstall": "adb uninstall com.petz247",
    "android:release:install": "npm run android:release && npm run android:adb:install",
    "android:release:run": "npm run android:release && npm run android:adb:install && npm run android:adb:start",
    "android:release:clean:run": "npm run android:release:clean && npm run android:adb:install && npm run android:adb:start",
    "build:android:apk": "npm run android:release",
    "build:android:aab": "npm run android:bundle",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@reduxjs/toolkit": "^2.9.0",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-gesture-handler": "^2.28.0",
